+++ b/configs/profiles/HexDemo_post_fix_RpmBench.txt
@@ -51,8 +51,6 @@
 #define USE_CATAPULT
 #define USE_LEARNER
 ## #define USE_NN_CONTROL
-#define LEARNER_HARDCODE_MAXRPM
-#define LEARNER_HARDCODE_LINEAR_FORCES
 
