 src/main/cli/settings.c                       |  2 ++
 src/main/fc/parameter_names.h                 |  2 ++
 src/main/flight/learner.c                     | 32 +++++++++++--------
 src/main/flight/learner.h                     |  2 ++
 7 files changed, 32 insertions(+), 18 deletions(-)

diff --git a/configs/profiles/HexDemo_post_fix.txt b/configs/profiles/HexDemo_post_fix.txt
