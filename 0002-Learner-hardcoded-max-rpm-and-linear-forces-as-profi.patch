 # RLS forgetting factor * 1e6 (1000000 = 1.0, no forgetting). 0 = use the bandwidth equation
 set learner_rls_lambda = 1000000
+# hardcoded learner outputs (replace the old LEARNER_HARDCODE_* build flags). 0 = learned
