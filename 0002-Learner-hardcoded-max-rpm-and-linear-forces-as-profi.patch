@@ -453,6 +451,9 @@ set learner_zeta_position = 90
 set learner_simple_motor_model = 1
 # RLS forgetting factor * 1e6 (1000000 = 1.0, no forgetting). 0 = use the bandwidth equation
 set learner_rls_lambda = 1000000
+# hardcoded learner outputs (replace the old LEARNER_HARDCODE_* build flags). 0 = learned
+set learner_hardcode_max_rpm = 37000
+set learner_hardcode_g1_fz = -438
 
 set learner_roll_misalignment = 0
 set learner_pitch_misalignment = 0
