From 163d338e4aece536efa0518bde8dd224f98de4e9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 18 Nov 2026 15:13:14 +0100
Subject: [PATCH] Learner: on/off switch for hardcoded linear forces, add fx
 and fy

learner_hardcode_g1_fz alone could not hardcode fx = fy = 0 once 0 means
"learned". Use an explicit switch instead:

- learner_hardcode_linear_forces (0/1, default 0)
  0: learned fx, fy, fz
  1: use learner_hardcode_g1_fx, _fy, _fz, where 0 is a valid value
- learner_hardcode_g1_fx, learner_hardcode_g1_fy (-32000..32000, default 0)
  same units as indi_act_g1_fx / indi_act_g1_fy

The old build flag LEARNER_HARDCODE_LINEAR_FORCES corresponds to
switch = 1, fx = 0, fy = 0, fz = -438. learnerConfig PG version 3 -> 4.
All three values and the switch are written to the blackbox header.
Profiles are not touched by this commit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ShSV4NN8hhaJjwwPzXK1XY
---
 src/main/blackbox/blackbox.c  |  3 +++
 src/main/cli/settings.c       |  3 +++
 src/main/fc/parameter_names.h |  3 +++
 src/main/flight/learner.c     | 15 +++++++++------
 src/main/flight/learner.h     |  5 ++++-
 5 files changed, 22 insertions(+), 7 deletions(-)

diff --git a/src/main/blackbox/blackbox.c b/src/main/blackbox/blackbox.c
index 23f24ce3c..01d760502 100644
--- a/src/main/blackbox/blackbox.c
+++ b/src/main/blackbox/blackbox.c
@@ -2850,6 +2850,9 @@ static bool blackboxWriteSysinfo(void)
         BLACKBOX_PRINT_HEADER_LINE(PARAM_NAME_LEARNER_SIMPLE_MOTOR_MODEL, "%d",  learnerConfig()->simpleMotorModel);
         BLACKBOX_PRINT_HEADER_LINE(PARAM_NAME_LEARNER_RLS_LAMBDA, "%u",  (unsigned) learnerConfig()->rlsLambda);
         BLACKBOX_PRINT_HEADER_LINE(PARAM_NAME_LEARNER_HARDCODE_MAX_RPM, "%u",  (unsigned) learnerConfig()->hardcodeMaxRpm);
+        BLACKBOX_PRINT_HEADER_LINE(PARAM_NAME_LEARNER_HARDCODE_LINEAR_FORCES, "%d",  learnerConfig()->hardcodeLinearForces);
+        BLACKBOX_PRINT_HEADER_LINE(PARAM_NAME_LEARNER_HARDCODE_G1_FX, "%d",  learnerConfig()->hardcodeG1Fx);
+        BLACKBOX_PRINT_HEADER_LINE(PARAM_NAME_LEARNER_HARDCODE_G1_FY, "%d",  learnerConfig()->hardcodeG1Fy);
         BLACKBOX_PRINT_HEADER_LINE(PARAM_NAME_LEARNER_HARDCODE_G1_FZ, "%d",  learnerConfig()->hardcodeG1Fz);
 #endif
 #ifdef USE_NN_CONTROL
diff --git a/src/main/cli/settings.c b/src/main/cli/settings.c
index 1fa706cb4..fa0046f60 100644
--- a/src/main/cli/settings.c
+++ b/src/main/cli/settings.c
@@ -1424,6 +1424,9 @@ const clivalue_t valueTable[] = {
     { PARAM_NAME_LEARNER_SIMPLE_MOTOR_MODEL, VAR_UINT8 | MASTER_VALUE, .config.minmaxUnsigned = { 0, 1 }, PG_LEARNER_CONFIG, offsetof(learnerConfig_t, simpleMotorModel) },
     { PARAM_NAME_LEARNER_RLS_LAMBDA,        VAR_UINT32 | MASTER_VALUE, .config.u32Max = 1000000, PG_LEARNER_CONFIG, offsetof(learnerConfig_t, rlsLambda) },
     { PARAM_NAME_LEARNER_HARDCODE_MAX_RPM,  VAR_UINT32 | MASTER_VALUE, .config.u32Max = 200000, PG_LEARNER_CONFIG, offsetof(learnerConfig_t, hardcodeMaxRpm) },
+    { PARAM_NAME_LEARNER_HARDCODE_LINEAR_FORCES, VAR_UINT8 | MASTER_VALUE, .config.minmaxUnsigned = { 0, 1 }, PG_LEARNER_CONFIG, offsetof(learnerConfig_t, hardcodeLinearForces) },
+    { PARAM_NAME_LEARNER_HARDCODE_G1_FX,    VAR_INT16 | MASTER_VALUE, .config.minmax = { -32000, 32000 }, PG_LEARNER_CONFIG, offsetof(learnerConfig_t, hardcodeG1Fx) },
+    { PARAM_NAME_LEARNER_HARDCODE_G1_FY,    VAR_INT16 | MASTER_VALUE, .config.minmax = { -32000, 32000 }, PG_LEARNER_CONFIG, offsetof(learnerConfig_t, hardcodeG1Fy) },
     { PARAM_NAME_LEARNER_HARDCODE_G1_FZ,    VAR_INT16 | MASTER_VALUE, .config.minmax = { -32000, 32000 }, PG_LEARNER_CONFIG, offsetof(learnerConfig_t, hardcodeG1Fz) },
 #endif
 
diff --git a/src/main/fc/parameter_names.h b/src/main/fc/parameter_names.h
index 5dd35e2d6..fae19df02 100644
--- a/src/main/fc/parameter_names.h
+++ b/src/main/fc/parameter_names.h
@@ -280,6 +280,9 @@
 #define PARAM_NAME_LEARNER_SIMPLE_MOTOR_MODEL "learner_simple_motor_model"
 #define PARAM_NAME_LEARNER_RLS_LAMBDA "learner_rls_lambda"
 #define PARAM_NAME_LEARNER_HARDCODE_MAX_RPM "learner_hardcode_max_rpm"
+#define PARAM_NAME_LEARNER_HARDCODE_LINEAR_FORCES "learner_hardcode_linear_forces"
+#define PARAM_NAME_LEARNER_HARDCODE_G1_FX "learner_hardcode_g1_fx"
+#define PARAM_NAME_LEARNER_HARDCODE_G1_FY "learner_hardcode_g1_fy"
 #define PARAM_NAME_LEARNER_HARDCODE_G1_FZ "learner_hardcode_g1_fz"
 #endif
 
diff --git a/src/main/flight/learner.c b/src/main/flight/learner.c
index 985845eb2..774c20487 100644
--- a/src/main/flight/learner.c
+++ b/src/main/flight/learner.c
@@ -65,7 +65,7 @@ learning_query_state_t learningQueryState = LEARNING_QUERY_IDLE;
 #error "must use learner with USE_INDI"
 #endif
 
-PG_REGISTER_WITH_RESET_TEMPLATE(learnerConfig_t, learnerConfig, PG_LEARNER_CONFIG, 3);
+PG_REGISTER_WITH_RESET_TEMPLATE(learnerConfig_t, learnerConfig, PG_LEARNER_CONFIG, 4);
 PG_RESET_TEMPLATE(learnerConfig_t, learnerConfig, 
     .mode = (uint8_t) LEARN_AFTER_CATAPULT,
     .numAct = 4,
@@ -93,7 +93,10 @@ PG_RESET_TEMPLATE(learnerConfig_t, learnerConfig,
     .simpleMotorModel = true, // behaviour since f5d3392 "simplify motor model"
     .rlsLambda = 1000000,     // lambda = 1, behaviour since 5bf60bd. 0: bandwidth equation
     .hardcodeMaxRpm = 0,      // 0: learned (was build flag LEARNER_HARDCODE_MAXRPM -> 37000)
-    .hardcodeG1Fz = 0         // 0: learned (was build flag LEARNER_HARDCODE_LINEAR_FORCES -> -438)
+    .hardcodeG1Fz = 0,
+    .hardcodeLinearForces = false, // 0: learned (was build flag LEARNER_HARDCODE_LINEAR_FORCES -> 0, 0, -438)
+    .hardcodeG1Fx = 0,
+    .hardcodeG1Fy = 0
 );
 
 // extern
@@ -939,10 +942,10 @@ void updateLearnedParameters(indiProfile_t* indi, positionProfile_t* pos) {
         actG2rotHover = actG2rotIMU[act];
         rotate_vector_with_rotationMatrix(&actG2rotHover, &imu_to_hoverR);
 
-        if (learnerConfig()->hardcodeG1Fz != 0) {
-            // learner_hardcode_g1_fz, replaces build flag LEARNER_HARDCODE_LINEAR_FORCES
-            indi->actG1_fx[act]    = 0;
-            indi->actG1_fy[act]    = 0;
+        if (learnerConfig()->hardcodeLinearForces) {
+            // learner_hardcode_linear_forces, replaces build flag LEARNER_HARDCODE_LINEAR_FORCES
+            indi->actG1_fx[act]    = learnerConfig()->hardcodeG1Fx;
+            indi->actG1_fy[act]    = learnerConfig()->hardcodeG1Fy;
             indi->actG1_fz[act]    = learnerConfig()->hardcodeG1Fz;
         } else {
             indi->actG1_fx[act]    = actG1linHover.V.X;
diff --git a/src/main/flight/learner.h b/src/main/flight/learner.h
index 8b42ebc37..c07b61d6e 100644
--- a/src/main/flight/learner.h
+++ b/src/main/flight/learner.h
@@ -60,7 +60,10 @@ typedef struct learnerConfig_s {
     uint8_t simpleMotorModel;   // 1: omega - idle = a*d - tau*omegaDot. 0: omega = a*d + b*sqrt(d) + c - tau*omegaDot
     uint32_t rlsLambda;         // RLS forgetting factor * 1e6. 0: from bandwidth equation (rlsInit). 1000000: no forgetting
     uint32_t hardcodeMaxRpm;    // 0: learned max rpm. otherwise: use this max rpm for all motors
-    int16_t hardcodeG1Fz;       // 0: learned linear forces. otherwise: fx = fy = 0, fz = this (same units as indi_act_g1_fz)
+    int16_t hardcodeG1Fz;       // used if hardcodeLinearForces. same units as indi_act_g1_fz, 0 is a valid value
+    uint8_t hardcodeLinearForces; // 0: learned fx, fy, fz. 1: use hardcodeG1Fx, hardcodeG1Fy, hardcodeG1Fz
+    int16_t hardcodeG1Fx;       // used if hardcodeLinearForces. same units as indi_act_g1_fx, 0 is a valid value
+    int16_t hardcodeG1Fy;       // used if hardcodeLinearForces. same units as indi_act_g1_fy, 0 is a valid value
 } learnerConfig_t;
 
 PG_DECLARE(learnerConfig_t, learnerConfig);
