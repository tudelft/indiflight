{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-openocd",
            "command": "/usr/bin/sshpass",
            "args": [
                "-p",
                "pi",
                "ssh",
                "-o",
                "StrictHostKeyChecking=no",
                "-o",
                "ConnectTimeout=3",
                "pi@10.0.0.1",
                "sudo",
                "systemctl",
                "start",
                "openocd.service"
            ],
            "type": "shell",
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": true
            }
        },
        {
            "label": "getLogs",
            "command": "${workspaceFolder}/support/log_downloader/get_logs.sh",
            "args": [
                "${input:mirrorDestination}"
            ],
            "type": "shell",
        },
    ],
    "inputs": [
        {
            "type": "promptString",
            "id": "mirrorDestination",
            "description": "Provide folder to dump all log files. WARNING: THE CONTENTS OF THIS FOLDER WILL BE OVERWRITTEN!",
            "default": ""
        }
    ]
}
