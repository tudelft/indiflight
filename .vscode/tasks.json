{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-openocd",
            "command": "/usr/bin/sshpass",
            "args": [
                "-p",
                "pi",
                "ssh",
                "-o",
                "StrictHostKeyChecking=no",
                "-o",
                "ConnectTimeout=3",
                "pi@10.0.0.1",
                "sudo",
                "systemctl",
                "start",
                "openocd.service"
            ],
            "type": "shell",
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": true
            }
        },
        {
            "label": "getLogs",
            "command": "${workspaceFolder}/support/log_downloader/get_logs.sh",
            "args": [
                "${input:mirrorDestination}"
            ],
            "type": "shell",
        },
        {
            // regenerates compile_commands.json with the #defines of
            // configs/boards/<board>.txt + configs/profiles/<profile>.txt
            "label": "IntelliSense: select board and profile",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/support/scripts/intellisense_config.py",
                "${input:intellisenseBoard}",
                "${input:intellisenseProfile}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
    ],
    "inputs": [
        // options are kept in sync with configs/*/*.txt by intellisense_config.py
        {
            "id": "intellisenseBoard",
            "type": "pickString",
            "description": "IntelliSense board (configs/boards)",
            "options": [
                "FPVM-BETAFLIGHTF4",
                "MTKS-H743"
            ]
        },
        {
            "id": "intellisenseProfile",
            "type": "pickString",
            "description": "IntelliSense profile (configs/profiles)",
            "options": [
                "CineRat",
                "CineRatGPS",
                "CineRatMotorTest",
                "CineRatOpti",
                "DarkO",
                "DarkOGPS",
                "DarkOHIL",
                "DarkOOpti",
                "DarkO_knownController",
                "DarkO_uros",
                "HexDemo",
                "HexDemo1",
                "HexDemo2",
                "HexDemo3",
                "Meteor75",
                "Meteor75_TomTests",
                "Meteor75_demo",
                "Meteor75_uros"
            ]
        },
        {
            "type": "promptString",
            "id": "mirrorDestination",
            "description": "Provide folder to dump all log files. WARNING: THE CONTENTS OF THIS FOLDER WILL BE OVERWRITTEN!",
            "default": ""
        }
    ]
}
