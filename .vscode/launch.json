{
    // Use IntelliSense to learn about possible Node.js debug attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": "${command:pickArgs}",
            "justMyCode": false
        },
        {
            "name": "Tailsitter Sim",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/support/simulation/exampleTailsitterSim.py",
            "args": [
                "--sil",
                "obj/main/indiflight_MOCKUP.so",
                "--sil-profile-txt",
                "./configs/profiles/DarkO.txt"
            ],
            "justMyCode": false
        },
        {
            // https://stackoverflow.com/questions/53519668/how-to-attach-to-remote-gdb-with-vscode
            "name": "MOCKUP docker",
            "type": "gdb",
            "request": "attach",
            //"executable": "${workspaceFolder}/obj/main/indiflight_MOCKUP.so",
            "target": "localhost:3333",
            "remote": true,
            "cwd": "${workspaceRoot}",
            "stopAtEntry": false,
        },
        {
            "name": "J-Link Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "STM32H743VI", // e.g., STM32F103C8
            "interface": "swd", // Use "jtag" for JTAG interface
            //"runToMain": true,
            "executable": "${workspaceFolder}/obj/main/indiflight_STM32H743.elf",
            "serialNumber": "", // Optional: Specify the serial number of your J-Link if needed
            //"interfaceSpeed": 4000, // Adjust speed if needed, e.g., 4000 for 4 MHz
            //"preLaunchTask": "build", // Optionally, you can define a pre-launch task for building your project
            //"postLaunchCommands": [
            //    "monitor reset halt",
            //    "monitor init"
            //],
            "cwd": "${workspaceFolder}"
            //"gdbpath": "path/to/your/gdb", // Optional: Set the path to your GDB if it's not in your PATH
            //"launchCompleteCommand": "exec-continue",
            //"serverStarted": "Waiting for GDB connection",
            //"showDevDebugOutput": true
        },
        {
            "cwd": "${workspaceRoot}",
            "executable": "obj/main/indiflight_STM32H743.elf",
            "name": "Cortex OpenOCD",
            "request": "launch",
            "preLaunchTask": "start-openocd",
            "type": "cortex-debug",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 2
            },
            "servertype": "external",
            "gdbTarget": "10.0.0.1:3333",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "objdumpPath": "/usr/bin/objdump"
        }
    ]
}